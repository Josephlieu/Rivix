#!/bin/sh
# Before every push: whole-project guard, type check, lint errors, and a check for known-vulnerable packages.
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
node scripts/guard.mjs || { echo "Push BLOCKED by guard."; exit 1; }
npx --no-install tsc --noEmit || { echo "Push BLOCKED: type errors."; exit 1; }
npx --no-install eslint src --quiet || { echo "Push BLOCKED: lint errors."; exit 1; }
npm audit --omit=dev --audit-level=high || { echo "Push BLOCKED: a package used by the live site has a high or critical vulnerability."; exit 1; }
exit 0
